{
  "name": "galinka",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build": "npm run check && vite build && node scripts/stamp-build.mjs && tsc -p server/tsconfig.json && node scripts/copy-schema.mjs",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "test": "tsx --env-file-if-exists=.env --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup.mjs",
    "desktop:dev": "node scripts/build-web.mjs --desktop && electron .",
    "desktop:build": "node scripts/build-desktop.mjs",
    "android:build": "node scripts/build-android.mjs",
    "android:release": "node scripts/build-android.mjs --release",
    "arch:build": "node scripts/build-arch.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electron/asar": "^4.3.1",
    "@fontsource-variable/golos-text": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@playwright/test": "^1.56.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "tar": "^7.5.22",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.11"
  },
  "description": "Galinka — место, где свои",
  "author": "Galinka",
  "main": "desktop/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/cl0rex1/Galinka.git"
  }
}
