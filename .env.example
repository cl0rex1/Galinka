# Prefer: npm run setup (generates random credentials).
POSTGRES_PASSWORD=replace-with-long-random-database-password
DATABASE_URL=postgres://galinka:replace-with-long-random-database-password@localhost:54329/galinka
# Shared sign-up code (12+ chars). Leave empty to allow only one-time invites from the admin panel.
INVITE_CODE=replace-with-random-invitation-code
APP_ORIGIN=http://localhost:5173
# Set true on your HTTPS server. false is only for local HTTP development.
COOKIE_SECURE=false
# Set 1 only when exactly one trusted reverse proxy sits in front of the app.
TRUST_PROXY=0
PORT=3001

# Public deployment (set these on CasaOS):
# PUBLIC_API_ORIGIN=https://mess.quiby.me
# VITE_API_BASE=/messenger
# EDGE_NETWORK=quiby-core_default
# BUILD_SHA=0.3.1

# Android push (optional; see docs/ANDROID.md)
# PUSH_ENABLED=true
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json

# Browser/PWA push, including installed iPhone web apps (keep the same key pair).
# Generate once: npx web-push generate-vapid-keys
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=https://mess.quiby.me

# Optional services for messages (0.14). Without them the defaults below are used.
# GIF search: a GIPHY or Tenor API key, or your own endpoint returning
# {items:[{id,title,previewUrl}]}. Unset, only the built-in animated set is offered.
# GIPHY_API_KEY=
# TENOR_API_KEY=
# GIF_API_URL=
# TikTok download: an extractor with the tikwm.com API shape. Unset, tikwm.com, then the page
# itself, then yt-dlp (if installed) are tried.
# TIKTOK_API_URL=

# Voice transcription for a server running outside Docker. Docker includes the CLI and model.
# WHISPER_PATH=/usr/bin/whisper-cli
# WHISPER_MODEL=/opt/whisper/base.bin
