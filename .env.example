# Prefer: npm run setup (generates random credentials).
POSTGRES_PASSWORD=replace-with-long-random-database-password
DATABASE_URL=postgres://galinka:replace-with-long-random-database-password@localhost:54329/galinka
INVITE_CODE=replace-with-random-invitation-code
APP_ORIGIN=http://localhost:5173
# Set true on your HTTPS server. false is only for local HTTP development.
COOKIE_SECURE=false
# Set 1 only when exactly one trusted reverse proxy sits in front of the app.
TRUST_PROXY=0
PORT=3001

# Public deployment (set these on CasaOS):
# PUBLIC_API_ORIGIN=https://mess.quiby.me
# VITE_API_BASE=/messenger
# EDGE_NETWORK=quiby-core_default
# BUILD_SHA=0.3.1

# Android push (optional; see docs/ANDROID.md)
# PUSH_ENABLED=true
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json
